rules_version = '2';

// =============================================================================
// DEVELOPMENT RULES (currently active)
// =============================================================================
// Open access, but with a hard expiry so the database can NEVER be left
// permanently open by accident. Adjust the date as needed during development.
//
// LIMITATION: real role-based security (Ranger vs Park Manager vs Liaison vs
// Researcher) CANNOT be enforced from the client `CurrentUserProvider` — that is
// a demo/session convenience only. Secure rules require Firebase Authentication
// (see the recommended block below). Do not treat these dev rules as secure.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}

