rules_version = '2';

// =============================================================================
// WILDGUARD FIRESTORE RULES (authenticated, role-aware)
// =============================================================================
// Now that WildGuard uses Firebase Authentication, backend access is gated on a
// signed-in user whose role lives on their `users/{uid}` document. The client
// `CurrentUserProvider` is a session convenience only and is NOT a security
// boundary — these rules are.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// NOTE: role-aware WRITE rules are intentionally conservative here (reference
// data is manager-only; field data is any signed-in user). Tightening field
// writes to per-park / per-owner ownership is a further design step — see
// README "Firestore security". A time-boxed development/emulator block is kept
// at the bottom (commented) for local work without Auth.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && userDoc().role == role;
    }

    function isManager() {
      return hasRole('parkManager');
    }

    // A user may always read their own profile; managers may read/write any
    // profile (admin provisioning). Users may update their own profile.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isManager() || request.auth.uid == uid;
    }

    // Reference data: any signed-in user reads; only managers write.
    match /parks/{id}           { allow read: if isSignedIn(); allow write: if isManager(); }
    match /patrol_routes/{id}   { allow read: if isSignedIn(); allow write: if isManager(); }
    match /risk_zones/{id}      { allow read: if isSignedIn(); allow write: if isManager(); }
    match /tracked_animals/{id} { allow read: if isSignedIn(); allow write: if isManager(); }

    // Field data: signed-in users read/write (tighten to per-park ownership as a
    // follow-up — see README).
    match /patrols/{id}              { allow read, write: if isSignedIn(); }
    match /patrol_positions/{id}     { allow read, write: if isSignedIn(); }
    match /incident_reports/{id}     { allow read, write: if isSignedIn(); }
    match /wildlife_risk_alerts/{id} { allow read, write: if isSignedIn(); }
    match /response_assignments/{id} { allow read, write: if isSignedIn(); }
    match /location_readings/{id}    { allow read, write: if isSignedIn(); }
    match /community_reports/{id}    { allow read, write: if isSignedIn(); }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// =============================================================================
// DEVELOPMENT / EMULATOR RULES (disabled)
// =============================================================================
// Open access with a hard expiry so the DB can never be left permanently open.
// Swap in ONLY for local development without Firebase Auth (e.g. the emulator).
//
// service cloud.firestore {
//   match /databases/{database}/documents {
//     match /{document=**} {
//       allow read, write: if request.time < timestamp.date(2026, 12, 31);
//     }
//   }
// }
