rules_version = '2';

// DEVELOPMENT rules for incident evidence photos (UC02, later).
// Hard expiry so storage can't be left permanently open. Replace with the
// authenticated block below once Firebase Auth is wired up.
service firebase.storage {
  match /b/{bucket}/o {
    match /incident-evidence/{incidentId}/{fileName} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}

